rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSingleAllowedUser(userId) {
      return request.auth != null &&
             request.auth.uid == userId &&
             request.auth.token.email == 'episode.kim@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // Grok Bot feed backup (server/feedStore.ts): id and contents derive from the feed secret,
    // so it can be read by exact id without login (no listing); only the owner writes it.
    match /feeds/{feedId} {
      allow get: if true;
      allow create: if isSingleAllowedUser(request.resource.data.uid);
      allow update: if isSingleAllowedUser(resource.data.uid) && isSingleAllowedUser(request.resource.data.uid);
      allow delete: if isSingleAllowedUser(resource.data.uid);

      // 강의 백업(server/feedStore.ts): 서버가 로그인 없이 씀. 내용은 피드 비밀값으로 암호화, 문서 id가 쓰기 권한.
      match /days/{date} {
        allow get: if true;
        allow create, update: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && exists(/databases/$(database)/documents/feeds/$(feedId))
          && request.resource.data.keys().hasOnly(['iv', 'data', 'updatedAt'])
          && request.resource.data.iv is string && request.resource.data.iv.size() <= 32
          && request.resource.data.data is string && request.resource.data.data.size() <= 800000
          && request.resource.data.updatedAt is string;
        allow delete: if isSingleAllowedUser(get(/databases/$(database)/documents/feeds/$(feedId)).data.uid);

        match /audio/{n} {
          allow get: if true;
          allow create, update: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && n.matches('^[0-7]$')
            && exists(/databases/$(database)/documents/feeds/$(feedId))
            && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
            && request.resource.data.data is string && request.resource.data.data.size() <= 800000
            && request.resource.data.updatedAt is string;
          allow delete: if isSingleAllowedUser(get(/databases/$(database)/documents/feeds/$(feedId)).data.uid);
        }
      }
    }

    // User profile and subcollections
    match /users/{userId} {
      allow get, write: if isSingleAllowedUser(userId);

      match /{subcollection=**} {
        allow read, write: if isSingleAllowedUser(userId);
      }
    }
  }
}
