rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSingleAllowedUser(userId) {
      return request.auth != null &&
             request.auth.uid == userId &&
             request.auth.token.email == 'episode.kim@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow get, write: if isSingleAllowedUser(userId);

      match /{subcollection=**} {
        allow read, write: if isSingleAllowedUser(userId);
      }
    }
  }
}
