rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSingleAllowedUser(userId) {
      return request.auth != null &&
             request.auth.uid == userId &&
             request.auth.token.email == 'episode.kim@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // Grok Bot feed backup (server/feedStore.ts): id and contents derive from the feed secret,
    // so it can be read by exact id without login (no listing); only the owner writes it.
    match /feeds/{feedId} {
      allow get: if true;
      allow create: if isSingleAllowedUser(request.resource.data.uid);
      allow update: if isSingleAllowedUser(resource.data.uid) && isSingleAllowedUser(request.resource.data.uid);
      allow delete: if isSingleAllowedUser(resource.data.uid);
    }

    // User profile and subcollections
    match /users/{userId} {
      allow get, write: if isSingleAllowedUser(userId);

      match /{subcollection=**} {
        allow read, write: if isSingleAllowedUser(userId);
      }
    }
  }
}
