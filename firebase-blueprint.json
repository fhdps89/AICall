{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with system settings and customizable prompt slots",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "job": { "type": "string" },
        "surveyTopics": { "type": "string" },
        "phillyRole": { "type": "string" },
        "sttEngine": { "type": "string" },
        "ttsEngine": { "type": "string" },
        "lectureTime": { "type": "string" },
        "feedSecret": { "type": "string" },
        "initialProgressConfigured": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "initialProgressConfigured"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Learning goal track with full verbatim tutor prompt and lesson progress",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string" },
        "why": { "type": "string" },
        "priority": { "type": "number" },
        "tutorPrompt": { "type": "string" },
        "nextLessonIndex": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paused", "done"] },
        "deadline": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "type", "tutorPrompt", "nextLessonIndex", "status"]
    },
    "UserPlan": {
      "title": "UserPlan",
      "description": "User weekly learning pattern and daily target minutes",
      "type": "object",
      "properties": {
        "weeklyPattern": {
          "type": "object",
          "properties": {
            "mon": { "type": "array", "items": { "type": "string" } },
            "tue": { "type": "array", "items": { "type": "string" } },
            "wed": { "type": "array", "items": { "type": "string" } },
            "thu": { "type": "array", "items": { "type": "string" } },
            "fri": { "type": "array", "items": { "type": "string" } },
            "sat": { "type": "array", "items": { "type": "string" } },
            "sun": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
        },
        "minutesPerDay": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["weeklyPattern", "minutesPerDay"]
    },
    "PlanChange": {
      "title": "PlanChange",
      "description": "Proposed or approved change record with before/after snapshots for plan and goals",
      "type": "object",
      "properties": {
        "requestedText": { "type": "string" },
        "summary": { "type": "string" },
        "before": { "type": "object" },
        "after": { "type": "object" },
        "status": { "type": "string", "enum": ["proposed", "approved", "rejected", "reverted"] },
        "at": { "type": "string" },
        "appliedAt": { "type": "string" }
      },
      "required": ["requestedText", "summary", "before", "after", "status", "at"]
    },
    "CoachMemory": {
      "title": "CoachMemory",
      "description": "Persistent memory of user constraints, preferences, and weak points",
      "type": "object",
      "properties": {
        "constraints": { "type": "array", "items": { "type": "string" } },
        "preferences": { "type": "array", "items": { "type": "string" } },
        "weakPoints": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["constraints", "preferences", "weakPoints"]
    },
    "CoachMessage": {
      "title": "CoachMessage",
      "description": "Chat log between user and the coach",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "coach", "system"] },
        "text": { "type": "string" },
        "at": { "type": "string" },
        "planChangeId": { "type": "string" }
      },
      "required": ["role", "text", "at"]
    },
    "Mistake": {
      "title": "Mistake",
      "description": "Mistake vault item for spaced repetition review",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string" },
        "source": { "type": "string", "enum": ["call", "keep_import"] },
        "sessionId": { "type": "string" },
        "goalId": { "type": "string" },
        "lessonTitle": { "type": "string" },
        "myPhrase": { "type": "string" },
        "naturalPhrase": { "type": "string" },
        "reason": { "type": "string" },
        "sourceStt": { "type": "string" },
        "stage": { "type": "number", "enum": [1, 3, 7, 14] },
        "nextReviewAt": { "type": "string" },
        "nextReviewDate": { "type": "string" },
        "status": { "type": "string", "enum": ["reviewing", "graduated", "deferred", "on_hold"] },
        "reopenCount": { "type": "number" },
        "graduatedAt": { "type": "string" },
        "graduatedReason": { "type": "string" }
      },
      "required": ["createdAt", "source", "myPhrase", "naturalPhrase", "reason", "stage", "status"]
    },
    "Session": {
      "title": "Session",
      "description": "Call session record with live transcript, audio recording chunks, partial STT, and connection telemetry",
      "type": "object",
      "properties": {
        "goalId": { "type": "string" },
        "lessonIndex": { "type": "number" },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" },
        "lastChunkAt": { "type": "string" },
        "status": { "type": "string", "enum": ["in-progress", "pending_review", "done", "aborted"] },
        "liveTranscript": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "model"] },
              "text": { "type": "string" },
              "timestamp": { "type": "number" }
            },
            "required": ["role", "text"]
          }
        },
        "recordingChunks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": { "type": "number" },
              "path": { "type": "string" },
              "storageUrl": { "type": "string" },
              "timestamp": { "type": "string" },
              "uploaded": { "type": "boolean" },
              "durationSeconds": { "type": "number" },
              "sizeBytes": { "type": "number" }
            },
            "required": ["index", "path", "timestamp", "uploaded", "durationSeconds"]
          }
        },
        "sttPartial": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "minuteIndex": { "type": "number" },
              "timeRange": { "type": "string" },
              "transcript": { "type": "string" },
              "timestamp": { "type": "string" },
              "sourceChunkIndices": { "type": "array", "items": { "type": "number" } }
            },
            "required": ["minuteIndex", "timeRange", "transcript", "timestamp"]
          }
        },
        "connectionPath": { "type": "string", "enum": ["direct", "proxy"] },
        "directFailCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["goalId", "lessonIndex", "startedAt", "status", "liveTranscript"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root document for user settings and preferences"
    },
    "/users/{userId}/plan": {
      "schema": "UserPlan",
      "description": "User weekly routine pattern and daily target"
    },
    "/users/{userId}/planChanges/{planChangeId}": {
      "schema": "PlanChange",
      "description": "Plan change history and proposed changes"
    },
    "/users/{userId}/coachMemory": {
      "schema": "CoachMemory",
      "description": "Coach memory items"
    },
    "/users/{userId}/coachMessages/{messageId}": {
      "schema": "CoachMessage",
      "description": "Coach chat conversation log"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "Individual goal tracks and lesson progress"
    },
    "/users/{userId}/mistakes/{mistakeId}": {
      "schema": "Mistake",
      "description": "User mistake vault for spaced repetition"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Call session history with connection telemetry"
    }
  }
}
